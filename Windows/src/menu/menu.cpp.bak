#include "menu.hpp"

#include "../dependencies/imgui/imgui.h"
#include "../dependencies/imgui/imgui_impl_win32.h"

#include "../mod/components/helper/helper.hpp"
#include "../mod/components/progression/progression.hpp"
#include "../mod/components/level/level.hpp"
#include "../mod/components/account/account.hpp"
#include "../mod/components/player/player.hpp"

namespace ig = ImGui;

static bool bAutoBurnCandles = false;
static bool bAutoBurnPlants = false;
static bool bAutoBurnDyes = false;
static bool bAutoCollectWax = false;
static int selectedCategory = 0;
static int selectedLevel = 0;
static int selectedAccount = 0;
static char saveCurrentAccountName[128] = "";

namespace Menu {
    void InitializeContext(HWND hwnd) {
        if (ig::GetCurrentContext( ))
            return;

        ImGui::CreateContext( );
        ImGui_ImplWin32_Init(hwnd);

        ImGuiIO& io = ImGui::GetIO( );
        io.IniFilename = io.LogFilename = nullptr;
    }

    void Render( ) {
        if (!bShowMenu)
            return;

        ig::Begin("ThatNoobSkyMod", nullptr);

        if (ig::BeginTabBar("MainTabs")) {
            if (ig::BeginTabItem("Progression")) {

                if (ig::Checkbox("Auto Burn Candles", &bAutoBurnCandles)) {
                    Progression::ToggleAutoBurnCandles(bAutoBurnCandles);
                }

                if (ig::Checkbox("Auto Burn Plants", &bAutoBurnPlants)) {
                    Progression::ToggleAutoBurnPlants(bAutoBurnPlants);
                }

                if (ig::Checkbox("Auto Burn Dyes", &bAutoBurnDyes)) {
                    Progression::ToggleAutoBurnPlants(bAutoBurnDyes);
                }

                //if (ig::Checkbox("Auto Burn Dyes", &bAutoCollectWax)) {
                //    Progression::ToggleAutoBurnPlants(bAutoCollectWax);
                //}
                
                ig::EndTabItem( );
            }

            if (ig::BeginTabItem("Level")) {
                const char* currentCategory = levelCategories[selectedCategory].name;
                if (ig::BeginCombo("Category", currentCategory)) {
                    for (int i = 0; i < (int)levelCategories.size( ); i++) {
                        bool isSelected = (selectedCategory == i);
                        if (ig::Selectable(levelCategories[i].name, isSelected)) {
                            selectedCategory = i;
                            selectedLevel = 0; // reset level selection when category changes
                        }
                        if (isSelected)
                            ig::SetItemDefaultFocus( );
                    }
                    ig::EndCombo( );
                }

                const auto& levels = levelCategories[selectedCategory].levels;
                const char* currentLevel = levels[selectedLevel];
                if (ig::BeginCombo("Level", currentLevel)) {
                    for (int i = 0; i < (int)levels.size( ); i++) {
                        bool isSelected = (selectedLevel == i);
                        if (ig::Selectable(levels[i], isSelected))
                            selectedLevel = i;
                        if (isSelected)
                            ig::SetItemDefaultFocus( );
                    }
                    ig::EndCombo( );
                }

                if (ig::Button("Load Level")) {
                    const char* chosenLevel = levelCategories[selectedCategory].levels[selectedLevel];
                    Level::Load(chosenLevel, true);
                }

                ig::EndTabItem( );
            }

            if (ig::BeginTabItem("Accounts")) {
                //if (ig::Button("Create New Account")) {
                //    Account::CreateNewAccount();
                //}

                if (ig::Button("Reload Current Account")) {
                    Account::ReloadCurrentAccount( );
                }

                ig::InputText("Account Name", saveCurrentAccountName, IM_ARRAYSIZE(saveCurrentAccountName));

                if (ig::Button("Save Current Account")) {
                    Account::SaveCurrentAccount(saveCurrentAccountName);
                    saveCurrentAccountName[0] = '\0';
                }

                if (!g_LocalAccounts.empty( )) {
                    if (selectedAccount >= (int)g_LocalAccounts.size( ))
                        selectedAccount = 0;

                    const char* currentAccount = g_LocalAccounts[selectedAccount].c_str( );

                    if (ig::BeginCombo("Account", currentAccount)) {
                        for (int i = 0; i < (int)g_LocalAccounts.size( ); i++) {
                            bool isSelected = (selectedAccount == i);
                            if (ig::Selectable(g_LocalAccounts[i].c_str( ), isSelected)) {
                                selectedAccount = i;
                            }
                            if (isSelected)
                                ig::SetItemDefaultFocus( );
                        }
                        ig::EndCombo( );
                    }

                    if (ig::Button("Switch Account")) {
                        Account::SwitchToAccount(g_LocalAccounts[selectedAccount]);
                    }
                } else {
                    ig::Text("No accounts available.");
                }

                ig::EndTabItem( );
            }

            if (ig::BeginTabItem("Player")) {
                if (ig::Button("Unlock All")) {
                    Player::UnlockAll( );
                }


                static char emoteName[64] = "";
                static float speedMultiplier = 1.0f;
                static float duration = 5.0f;
                static int level = 0;

                ig::Text("Emote");
                ig::Separator( );

                ig::InputText("Emote Name", emoteName, IM_ARRAYSIZE(emoteName));
                ig::InputFloat("Speed Multiplier", &speedMultiplier, 0.1f, 1.0f, "%.2f");
                ig::InputFloat("Duration", &duration, 0.1f, 1.0f, "%.2f");
                ig::InputInt("Level", &level);

                if (level < 1) level = 1;
                if (level > 6) level = 6;

                if (ig::Button("Play Emote", ImVec2(120, 0))) {
                    Player::PlayEmote(emoteName, speedMultiplier, duration, level);
                }

                ig::EndTabItem( );
            }


            ig::EndTabBar( );
        }

        ig::End( );
    }

    // Optional: function to access the checkbox state from outside
    bool IsAutoBurnCandlesEnabled( ) {
        return bAutoBurnCandles;
    }
} // namespace Menu
